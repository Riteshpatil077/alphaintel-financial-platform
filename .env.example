# ==========================================
# AlphaIntel Platform Configuration
# ==========================================

# Backend API Base URL (used by Streamlit frontend to reach FastAPI)
# Local development default:
ALPHAINTEL_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production deployment example:
# ALPHAINTEL_API_BASE_URL=https://alphaintel-api.onrender.com/api/v1

# Server port (used by cloud host providers like Render / Cloud VM)
PORT=8000
